Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - /Current View1
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 30; 32; 38
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 20
    Reference Frame: map
  - Class: rviz_default_plugins/MarkerArray
    Name: Task nodes and platform stair regions
    Enabled: true
    Namespaces: {}
    Topic:
      Value: /navigation/scene
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Astar occupancy and stair height cells
    Enabled: true
    Namespaces: {}
    Topic:
      Value: /simulation/terrain_grid
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Reference path
    Enabled: true
    Color: 0; 220; 255
    Line Style: Lines
    Line Width: 0.05
    Pose Style: None
    Topic:
      Value: /navigation/reference_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Actual integrated trajectory
    Enabled: true
    Color: 255; 210; 40
    Line Style: Lines
    Line Width: 0.04
    Pose Style: None
    Topic:
      Value: /simulation/trajectory
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Pose
    Name: Current lookahead reference
    Enabled: true
    Color: 255; 80; 100
    Shape: Arrow
    Shaft Length: 0.3
    Shaft Radius: 0.04
    Head Length: 0.15
    Head Radius: 0.08
    Topic:
      Value: /navigation/reference_point
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Pose
    Name: Robot localization
    Enabled: true
    Color: 100; 255; 100
    Shape: Arrow
    Shaft Length: 0.35
    Shaft Radius: 0.05
    Head Length: 0.16
    Head Radius: 0.09
    Topic:
      Value: /localization/pose
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/Map
    Name: Compatibility platform occupancy
    Enabled: false
    Alpha: 0.65
    Color Scheme: map
    Draw Behind: false
    Topic:
      Value: /simulation/platform_grid
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Live obstacle detection corridor
    Enabled: true
    Namespaces: {}
    Topic:
      Value: /navigation/obstacle_zone
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Synthetic pedestrian
    Enabled: true
    Namespaces: {}
    Topic:
      Value: /simulation/obstacles
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/PointCloud2
    Name: Live ground and pedestrian cloud
    Enabled: true
    Alpha: 0.85
    Size (m): 0.035
    Style: Points
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Topic:
      Value: /simulation/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8.5
      Focal Point:
        X: 2.5
        Y: 0.0
        Z: 0.4
      Pitch: 0.65
      Yaw: 4.5
      Target Frame: map
Window Geometry:
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: false
  Width: 1280
  Height: 800
